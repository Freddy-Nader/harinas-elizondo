}

% Back links between the text and the appendix. \fref and \coref leave a mark the first
% time something is cited (\bkmark), and \backto{label} links back to that mark.
\definecolor{backlink}{HTML}{2F6F9F}
\newcommand{\bkmark}[1]{\ifcsname bk@seen@#1\endcsname\else
  \expandafter\gdef\csname bk@seen@#1\endcsname{}\hypertarget{bk:#1}{}\label{bk:#1}\fi}
\DeclareRobustCommand{\backto}[1]{\ifcsname r@bk:#1\endcsname
  \hyperlink{bk:#1}{\textcolor{backlink}{\textit{(p.~\pageref*{bk:#1})}}}\fi}
\newcommand{\backline}[1]{\par\nopagebreak{\centering\footnotesize\backto{#1}\par}}
\newcommand{\backlinecode}[1]{\par\nopagebreak\vspace{-1.1\baselineskip}{\centering\footnotesize\backto{#1}\par}}

\lstnewenvironment{codigo}[1][]
  {\let\lst@label\@empty
   \lstset{style=consola,#1}}
  {\ifx\lst@label\@empty\else
     \expandafter\backlinecode\expandafter{\lst@label}%
   \fi}

