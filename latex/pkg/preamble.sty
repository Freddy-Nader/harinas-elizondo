% --- Commands ---------------------------------------------------------------
% Inside a .sty the @ is already a letter, so no \makeatletter is needed.

\renewcommand{\tt}[1]{\texttt{#1}}

\newcommand{\tref}[1]{Tabla~\ref{#1}}
\newcommand{\fref}[1]{\hyperref[#1]{Figura~\ref*{#1}}\bkmark{#1}}
\newcommand{\sref}[1]{\S \ref{#1}}
\newcommand{\aref}[1]{Anexo~\ref{#1}}
\newcommand{\coref}[1]{\hyperref[#1]{Código~\ref*{#1}}\bkmark{#1}}

% Missing facts. \pend prints red text in place of something the repo cannot tell
% (team conclusions, who did what, dates of meetings). None may remain at delivery.
\newcommand{\pend}[1]{\textcolor{red}{\textbf{[#1]}}}

% \captura[width]{file-without-extension}{caption}. The image lives in ../docs/img/file.png.
% While it does not exist, a red box is drawn so the document still compiles.
\newcommand{\captura}[3][0.95]{%
  \begin{figure}[H]
    \centering
    \IfFileExists{../docs/img/#2.png}%
      {\includegraphics[width=#1\linewidth,height=0.45\textheight,keepaspectratio]{#2}}%
      {\fbox{\parbox{0.8\linewidth}{\centering\vspace{1.4cm}\textcolor{red}{\textbf{CAPTURA PENDIENTE}}\\[0.4em]\texttt{#2.png}\vspace{1.4cm}}}}%
    \caption{#3}\label{fig:#2}
    \backline{fig:#2}
  \end{figure}}

